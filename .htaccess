RewriteEngine On

# --- Clean URLs (remove .html) — preserves the query string so product
#     pages like /pages/product?id=sq-... keep working. ---

# 1) /index.html  ->  /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 2) /page.html  ->  /page   (NO trailing "?" so ?id=... is KEPT)
RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) Internally serve the real .html file for the extensionless URL
#    (works even if MultiViews is disabled; query string is passed through)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
